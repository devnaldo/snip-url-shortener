{
  "name": "snip",
  "version": "0.1.0",
  "private": true,
  "description": "URL shortener with analytics",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=@snip/server",
    "dev:client": "npm run dev --workspace=@snip/client",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@snip/server",
    "start:prod": "npm run migrate:prod --workspace=@snip/server && npm run start --workspace=@snip/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run migrate --workspace=@snip/server",
    "migrate:generate": "npm run migrate:generate --workspace=@snip/server",
    "seed": "npm run seed --workspace=@snip/server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
