# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
# Production requires HTTPS BASE_URL/CLIENT_URL values without trailing slashes
# and non-placeholder secrets.
NODE_ENV=development

# Port the Express API listens on.
# In production, set this to the port your reverse proxy forwards to.
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml (local development defaults).
# Production: use your managed PostgreSQL connection string and require TLS,
# e.g. postgresql://user:password@host:5432/snip?sslmode=require. Certificate
# verification stays enabled; never disable it (for example with ssl.rejectUnauthorized=false).
DATABASE_URL=postgresql://snip:snip@localhost:5432/snip

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Public origin of the app, used to build short links (e.g. https://snip.dev).
# Production: must be an https URL with no trailing slash.
BASE_URL=http://localhost:3000

# Frontend origin allowed by CORS. Must include the scheme, no trailing slash.
# Production: must be an https URL with no trailing slash.
CLIENT_URL=http://localhost:5173

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Signing key for auth JWTs. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Production rejects this placeholder value; set a unique generated secret.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# Server-side secret used to derive the daily salt for visitor hashes.
# Minimum 32 characters. Rotating this value resets unique-visitor counts.
# Generate with: openssl rand -hex 32
# Production rejects this placeholder value; set a unique generated secret.
CLICK_HASH_SECRET=change-me-click-hash-secret-at-least-32-chars

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Number of reverse-proxy hops trusted for the client IP (X-Forwarded-For).
# Keep at 0 when the API is directly exposed; use 1 behind a single proxy.
# Production: set this to the number of proxies in front of the app (usually 1).
TRUST_PROXY=0

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Maximum number of links a single user may create per window.
# Production: tune this to your expected usage.
LINK_RATE_LIMIT_MAX=20

# Length of the link-creation rate-limit window in milliseconds (default: 1 hour).
# Production: tune alongside LINK_RATE_LIMIT_MAX.
LINK_RATE_LIMIT_WINDOW_MS=3600000
