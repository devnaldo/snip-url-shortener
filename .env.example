# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# Port the Express API listens on.
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml (local development defaults).
DATABASE_URL=postgresql://snip:snip@localhost:5432/snip

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Public origin of the app, used to build short links (e.g. https://snip.dev).
BASE_URL=http://localhost:3000

# Frontend origin allowed by CORS. Must include the scheme, no trailing slash.
CLIENT_URL=http://localhost:5173

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Signing key for auth JWTs. Minimum 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# Server-side secret used to derive the daily salt for visitor hashes.
# Minimum 32 characters. Rotating this value resets unique-visitor counts.
# Generate with: openssl rand -hex 32
CLICK_HASH_SECRET=change-me-click-hash-secret-at-least-32-chars

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Number of reverse-proxy hops trusted for the client IP (X-Forwarded-For).
# Keep at 0 when the API is directly exposed; use 1 behind a single proxy.
TRUST_PROXY=0

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Maximum number of links a single user may create per window.
LINK_RATE_LIMIT_MAX=20

# Length of the link-creation rate-limit window in milliseconds (default: 1 hour).
LINK_RATE_LIMIT_WINDOW_MS=3600000
